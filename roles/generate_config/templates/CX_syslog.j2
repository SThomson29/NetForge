{# =============================================================
   Template : CX_syslog.j2
   Role     : generate_config
   Device   : {{ inventory_hostname }}
   Platform : {{ platform | default("aoscx") }}
   Variables: syslog.server, syslog.severity
   Note     : Only renders if syslog.server is populated.
              severity is omitted entirely when left empty, so a blank
              value cannot emit a dangling "severity" keyword.
   ============================================================= #}

{% if syslog.server | default("") %}
{% set severity = " severity " ~ syslog.severity if syslog.severity | default("") else "" %}
logging {{ syslog.server }}{{ severity }}
{% endif %}
